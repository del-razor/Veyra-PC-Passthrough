#include <windows.h>
#include "veyra-resource.h"
IDI_VEYRA ICON "overrez.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @OVERREZ_VERSION_MAJOR@,@OVERREZ_VERSION_MINOR@,@OVERREZ_VERSION_PATCH@,0
 PRODUCTVERSION @OVERREZ_VERSION_MAJOR@,@OVERREZ_VERSION_MINOR@,@OVERREZ_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "OverRez"
   VALUE "FileVersion", "@OVERREZ_RC_VERSION@"
   VALUE "ProductName", "OverRez"
   VALUE "ProductVersion", "@OVERREZ_RC_VERSION@"
   VALUE "OriginalFilename", "@VEYRA_RESOURCE_FILENAME@"
   VALUE "LegalCopyright", "OverRez, based on Veyra by Likely7. GPL-3.0."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
